<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": InkOverlay.exe and InkOverlay.dll from dotnet publish.
     Paste into SignPath (project InkOverlay → Artifact configurations). Used by .github/workflows/release.yml. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" default-value="1.0.0" />
  </parameters>
  <zip-file>
    <pe-file path="InkOverlay.exe" product-name="InkOverlay" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="InkOverlay.dll" product-name="InkOverlay" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
